{
  "name": "ios8-manifest",
  "private": true,
  "type": "module",
  "description": "Engine, showcase and starter for full-screen apps on the iOS 8 iPad minis (IPAD-01..05)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "serve": "node tools/dev.mjs --static",
    "build": "node tools/build.mjs --app apps/showcase --out dist && node tools/build.mjs --app apps/starter --out dist/starter",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "test": "vitest run",
    "icons": "node tools/icons.mjs",
    "ipad:open": "node tools/ipad.mjs open",
    "ipad:install": "node tools/ipad.mjs install",
    "ipad:remove": "node tools/ipad.mjs remove",
    "sheets": "node tools/sheets.mjs",
    "ipad:eval": "node tools/eval.mjs",
    "ipad:shot": "node tools/ipad.mjs shot"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@types/p5": "^1.7.7",
    "acorn": "^8.19.0",
    "core-js-bundle": "^3.51.0",
    "esbuild": "^0.25.12",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
